{
  "name": "lullaby-ide",
  "version": "0.1.0",
  "exports": "./main.ts",
  "tasks": {
    "build": "deno task build:web && deno task assets",
    "build:web": "npm --prefix web run build",
    "assets": "deno run -A scripts/build-assets.ts",
    "web:dev": "npm --prefix web run dev",
    "dev": "deno task build && deno desktop --hmr --allow-read --allow-write --allow-net --allow-env --allow-run --allow-ffi main.ts",
    "desktop": "deno task build && deno desktop --allow-read --allow-write --allow-net --allow-env --allow-run --allow-ffi --output ./dist/LullabyIDE.app main.ts",
    "start": "deno task build && deno run --allow-read --allow-write --allow-net --allow-env --allow-run --allow-ffi main.ts",
    "check": "deno check --desktop main.ts",
    "test": "deno test -A test/",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "imports": {
    "@std/yaml": "jsr:@std/yaml@^1.3.0",
    "zod": "npm:zod@^3.24.1",
    "sanitize-html": "npm:sanitize-html@2.17.0",
    "@sigma/pty-ffi": "jsr:@sigma/pty-ffi@0.42.0",
    "@cursor/sdk": "npm:@cursor/sdk@1.2.0"
  },
  "desktop": {
    "app": {
      "name": "Lullaby IDE",
      "identifier": "com.klgroup.rndworkflow"
    },
    "backend": "webview",
    "output": {
      "macos": "./dist/LullabyIDE",
      "windows": "./dist/LullabyIDE",
      "linux": "./dist/LullabyIDE"
    }
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "include": ["main.ts", "*.md", "src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"],
    "exclude": ["src/ui/assets.generated.ts"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    },
    "exclude": [".agents/**", "src/ui/assets.generated.ts", "web/**"]
  }
}
