{
  "name": "rnd-workflow",
  "version": "0.1.0",
  "exports": "./main.ts",
  "tasks": {
    "build": "deno task build:web && deno task assets",
    "build:web": "npm --prefix web run build",
    "assets": "deno run -A scripts/build-assets.ts",
    "web:dev": "npm --prefix web run dev",
    "dev": "deno task build && deno desktop --hmr --allow-read --allow-write --allow-net --allow-env --allow-run main.ts",
    "desktop": "deno task build && deno desktop --allow-read --allow-write --allow-net --allow-env --allow-run --output ./dist/RNDWorkflow.app main.ts",
    "start": "deno task build && deno run --allow-read --allow-write --allow-net --allow-env --allow-run main.ts",
    "check": "deno check --desktop main.ts",
    "test": "deno test -A",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "imports": {
    "zod": "npm:zod@^3.24.1"
  },
  "desktop": {
    "app": {
      "name": "RND Workflow",
      "identifier": "com.klgroup.rndworkflow"
    },
    "backend": "webview",
    "output": {
      "macos": "./dist/RNDWorkflow.app",
      "windows": "./dist/RNDWorkflow",
      "linux": "./dist/rnd-workflow"
    }
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "include": ["main.ts", "*.md", "src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"],
    "exclude": ["src/ui/assets.generated.ts"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    },
    "exclude": [".agents/**", "src/ui/assets.generated.ts", "web/**"]
  }
}
